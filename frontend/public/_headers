##############################################################################
# _headers — Netlify HTTP Response Headers
# Noble Security Services — noblesecurityservices.com
#
# Tasks:
#   6  — Transport Security (HTTPS/TLS) — HSTS
#   7  — Security Headers
#   14 — CORS Configuration
#   15 — Content Security Policy (CSP)
#   17 — Subresource Integrity (cache headers)
#   18 — Server-side Rate Limiting (advisory; see netlify.toml)
#   26 — Clickjacking Protection (X-Frame-Options)
#
# After deploying, verify at: https://securityheaders.com
##############################################################################

/*
  # ── Task 6: Transport Security — HSTS ──────────────────────────────────
  # Forces HTTPS for 1 year; includes subdomains; preloaded.
  # IMPORTANT: Only enable preload after the site is 100% HTTPS-ready.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # ── Task 7: Security Headers ────────────────────────────────────────────
  # Prevent MIME-type sniffing attacks
  X-Content-Type-Options: nosniff

  # Control referrer information sent with requests
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser feature APIs
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Prevent browsers from doing DNS prefetching
  X-DNS-Prefetch-Control: off

  # IE compatibility — force IE to use its latest rendering engine
  X-UA-Compatible: IE=edge

  # Cross-Origin policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Cross-Origin-Embedder-Policy: require-corp

  # ── Task 26: Clickjacking Protection ────────────────────────────────────
  X-Frame-Options: DENY

  # ── Task 15: Content Security Policy (CSP) ──────────────────────────────
  # Allowlist: self + Google Fonts + Google Maps iframe + WhatsApp/social links
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content;

  # ── Task 14: CORS Configuration ─────────────────────────────────────────
  # Restrict cross-origin requests to the same origin
  Access-Control-Allow-Origin: https://www.noblesecurityservices.com
  Access-Control-Allow-Methods: GET, OPTIONS
  Access-Control-Allow-Headers: Content-Type

# ── Static assets — long-term caching + immutable (Task 17: SRI) ─────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Public files — short-term caching
/robots.txt
  Cache-Control: public, max-age=86400
  X-Robots-Tag: noindex

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=UTF-8
